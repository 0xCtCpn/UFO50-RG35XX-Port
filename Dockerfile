FROM debian:bookworm
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf make pkg-config git python3 curl ca-certificates \
    autoconf automake libtool cmake ninja-build patch file xz-utils bzip2 unzip zip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build

# MiaUI v2.0.0 ships glibc 2.37 (Buildroot 2023.05.1) with
# /lib/ld-linux-armhf.so.3. The Debian bookworm armhf cross compiler produces
# binaries needing <= GLIBC_2.36, so it is compatible. No musl, no /tmp loader
# staging (that is a Garlic-era requirement, not MiaUI).
RUN arm-linux-gnueabihf-gcc --version

COPY toolchain-glibc.cmake /build/toolchain-glibc.cmake
COPY runtime /build/runtime
COPY patches /build/patches
# Minimal one-line controller DB: the full upstream 593 KB DB would make
# loadGamepadMappings() call the very slow SDL_JoystickName() ~9000 times at
# startup on MiaUI. See gamecontrollerdb.txt.
COPY gamecontrollerdb.txt /build/gamecontrollerdb.txt

# alsa-lib for ARM (glibc) FIRST. SDL 1.2's configure silently drops its ALSA
# driver when headers/-lasound are missing at configure time; that surfaces
# on-device as "SDL_OpenAudio failed: No available audio device" (the exact
# Undertale v1.0.0 bug). The cross-built libasound.so is used ONLY at link
# time and is deliberately NOT shipped: on MiaUI the SYSTEM libasound 1.2.10
# + /etc/asound.conf is the only working stack (see launch.sh / CMD below).
RUN curl -sSL --retry 3 --retry-all-errors https://www.alsa-project.org/files/pub/lib/alsa-lib-1.2.12.tar.bz2 -o alsa.tar.bz2 && \
    tar xjf alsa.tar.bz2 && cd alsa-lib-1.2.12 && \
    CC=arm-linux-gnueabihf-gcc CFLAGS="-march=armv7-a -mfpu=neon -mfloat-abi=hard -O2" \
    ./configure --host=arm-linux-gnueabihf --prefix=/opt/arm-alsa-glibc \
      --disable-python --disable-aload --without-debug && \
    make -j$(nproc) && make install

# SDL 1.2.15 with the linux framebuffer (fbcon) video driver and ALSA audio.
# MiaUI has no GBM/DRM/KMS path for its PowerVR SGX544MP, so GL/GLES from SDL
# is unusable here; the UFO50 runtime's software renderer + native 384x216
# framebuffer is the supported route. Hard-fail if the ALSA driver did not
# get compiled in.
RUN git clone --depth 1 --branch release-1.2.15 https://github.com/libsdl-org/SDL-1.2.git SDL12 && \
    cd SDL12 && (./autogen.sh 2>/dev/null || autoreconf -fi) && \
    PATH=/opt/arm-alsa-glibc/bin:$PATH CC=arm-linux-gnueabihf-gcc \
    CFLAGS="-march=armv7-a -mfpu=neon -mfloat-abi=hard -O2 -I/opt/arm-alsa-glibc/include" \
    LDFLAGS="-L/opt/arm-alsa-glibc/lib" \
    CPPFLAGS="-I/opt/arm-alsa-glibc/include" \
    ./configure --host=arm-linux-gnueabihf --prefix=/opt/arm-sdl12-glibc \
      --disable-video-x11 --disable-video-directfb --disable-video-ps2gs --disable-video-ps3 \
      --disable-video-ggi --disable-video-svga --disable-video-aalib --disable-video-dga \
      --enable-video-fbcon \
      --enable-alsa --disable-alsa-shared \
      --disable-oss --disable-esd --disable-pulseaudio --disable-arts --disable-nas \
      --disable-cdrom \
    && grep -m1 "SDL_VIDEO_DRIVER_FBCON" include/SDL_config.h && \
       grep -m1 "SDL_AUDIO_DRIVER_ALSA" include/SDL_config.h && \
       make -j$(nproc) && make install && \
       ls /opt/arm-sdl12-glibc/lib/libSDL*.so* && \
       grep -a -q 'ALSA PCM audio' /opt/arm-sdl12-glibc/lib/libSDL.so \
         && echo "SDL alsa driver OK" \
         || (echo "SDL built WITHOUT alsa audio driver"; exit 1)

# MiaUI patches (generated by tools/gen_patches.py against the pristine
# vendored runtime, so `git apply` must succeed for every file - no silent
# failures). 001 = RG35XX gamepad fallback map (dpad at sdl 13..16, sdl 12
# is the volume key), 002 = cache SDL_JoystickName out of the per-frame path
# (it is an open()+ioctl on this pad and halves the framerate), 003 = hide
# the fbcon stub cursor + Select+Start clean exit.
RUN cd /build/runtime && \
    for p in /build/patches/*.patch; do \
      echo "applying $p" && \
      git apply --ignore-whitespace --whitespace=nowarn --verbose "$p" || { echo "FAILED $p"; exit 1; } ; \
    done && \
    grep -c 'createFallbackMappings' src/backends/sdl1.c && \
    grep -c 'joyNameCache' src/backends/sdl1.c && \
    echo "runtime patches OK"

# UFO 50 is a GameMaker Studio 2 / WAD 17 game: WAD17 ONLY (WAD14/WAD16 off
# keeps the interpreter hot path small). PLATFORM=cli BACKEND=sdl1
# AUDIO_BACKEND=sdl1 (SDL audio -> libasound -> system ALSA), software
# renderer only (no GL/GLES on this device). All heavy lazy-loading flags
# are passed at runtime by launch.sh - the device has 256 MB RAM and UFO50's
# textures/audio groups are large.
RUN cd /build/runtime && \
    cmake -B build -G Ninja \
      -DCMAKE_TOOLCHAIN_FILE=/build/toolchain-glibc.cmake \
      -DPLATFORM=cli -DBACKEND=sdl1 -DAUDIO_BACKEND=sdl1 \
      -DENABLE_SW_RENDERER=ON -DENABLE_LEGACY_GL=OFF -DENABLE_MODERN_GL=OFF \
      -DENABLE_WAD14=OFF -DENABLE_WAD16=OFF -DENABLE_WAD17=ON \
      -DENABLE_VM_GML_PROFILER=OFF -DENABLE_VM_TRACING=OFF \
      -DENABLE_VM_OPCODE_PROFILER=OFF -DENABLE_VM_STUB_LOGS=ON \
      -DCMAKE_BUILD_TYPE=Release -DWERROR=OFF \
      -DBUTTERSCOTCH_COMMIT_HASH="ufo50-miau-0.1.9" \
      -DSDL_INCLUDE_DIR=/opt/arm-sdl12-glibc/include/SDL \
      -DSDL_LIBRARY=/opt/arm-sdl12-glibc/lib/libSDL.so \
      -DCMAKE_C_FLAGS="-march=armv7-a -mfpu=neon -mfloat-abi=hard -O3 -DNDEBUG -I/opt/arm-sdl12-glibc/include" \
      -DCMAKE_EXE_LINKER_FLAGS="-L/opt/arm-sdl12-glibc/lib -L/opt/arm-alsa-glibc/lib -lasound -Wl,--allow-shlib-undefined" \
    && cmake --build build -j$(nproc) \
    && ls -lh build/butterscotch

# Deliberately NOT copying libasound.so* or share/alsa to /out: bundling the
# cross-built alsa-lib 1.2.12 (datadir /opt/arm-alsa-glibc, absent on-device)
# shadows the SYSTEM libasound via launch.sh's LD_LIBRARY_PATH and kills
# audio (Undertale v1.0.0 release bug). butterscotch is glibc, so its
# libasound dependency must resolve to the system lib at runtime.
CMD mkdir -p /out && cp /build/runtime/build/butterscotch /out/ && \
    cp /build/gamecontrollerdb.txt /out/; \
    cp /opt/arm-sdl12-glibc/lib/libSDL-1.2.so* /out/ 2>/dev/null || true; \
    ls -lh /out/ && arm-linux-gnueabihf-readelf -l /out/butterscotch | grep INTERP; \
    arm-linux-gnueabihf-readelf -d /out/butterscotch | grep NEEDED
